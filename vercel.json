{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/Dashboard",    "destination": "/Dashboard/",    "permanent": false },
    { "source": "/proef",        "destination": "/proef/",        "permanent": false },
    { "source": "/proeflicentie","destination": "/proef/",        "permanent": false }
  ],
  "rewrites": [
    { "source": "/Dashboard/",      "destination": "/Dashboard/dashboard.html" },
    { "source": "/proef/",          "destination": "/Proeflicentie/dashboard.html" },
    { "source": "/proef/inloggen",  "destination": "/Proeflicentie/inlogpagina.html" },
    { "source": "/les1", "destination": "/Les/index.html" },
