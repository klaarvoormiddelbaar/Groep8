{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/Dashboard", "destination": "/Dashboard/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/Dashboard/", "destination": "/Dashboard/dashboard.html" },
    { "source": "/les1", "destination": "/Les1/index.html" },
    { "source": "/les2", "destination": "/Les2/index.html" },
    { "source": "/les3", "destination": "/Les3/index.html" },
    { "source": "/les4", "destination": "/Les4/index.html" },
    { "source": "/les5", "destination": "/Les5/index.html" },
    { "source": "/les6", "destination": "/Les6/index.html" },
    { "source": "/les7", "destination": "/Les7/index.html" },
    { "source": "/les8", "destination": "/Les8/index.html" },
    { "source": "/les1/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les2/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les3/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les4/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les5/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les6/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les7/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les8/quiz", "destination": "/KvM Quiz/join.html" },
    { "source": "/les1/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les2/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les3/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les4/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les5/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les6/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les7/wolk", "destination": "/Live poll/join.html" },
    { "source": "/les8/wolk", "destination": "/Live poll/join.html" }
  ]
}
